# ========== DashScope（阿里云通义千问 · 必须） ==========
# Embedding 和 Reranker 都需要
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ========== 以下一般不需要改 ==========

# 运行模式：streamlit（默认）或 api
# APP_MODE=api 时启动 FastAPI 而非 Streamlit

# Elasticsearch 地址（Docker 下自动指向 es 容器）
ES_HOST=http://localhost:9200

# Ollama 地址（Docker 下自动指向 ollama 容器）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# 向量库存储路径
CHROMA_PERSIST_DIR=./chroma_db
